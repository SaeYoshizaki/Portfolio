---
import BaseLayout from "../layouts/BaseLayout.astro";

const roomLinks = [
  {
    title: "About",
    description: "自己紹介・経歴",
    href: "/about/",
    className: "room-link--about",
  },
  {
    title: "Projects",
    description: "開発したプロジェクト",
    href: "/projects/",
    className: "room-link--projects",
  },
  {
    title: "Research",
    description: "研究・解析・発表など",
    href: "/research/",
    className: "room-link--research",
  },
  {
    title: "Notes",
    description: "技術ブログ・メモ",
    href: "/notes/",
    className: "room-link--notes",
  },
  {
    title: "Contact",
    description: "連絡先・SNSなど",
    href: "/contact/",
    className: "room-link--contact",
  },
];
---

<BaseLayout
  title="Sae Yoshizaki"
  description="IoTセキュリティとネットワーク解析に取り組むSaeの個人サイト"
>
  <main class="home-page">
    <header class="home-header">
      <a class="home-logo" href="/" aria-label="Sae Yoshizaki ホーム">Sae Yoshizaki</a>
    </header>

    <section class="room-menu" aria-label="部屋を探索する">
      <img
        class="room-image"
        src="/images/home/room.png"
        alt="机、本棚、ホワイトボード、ネットワーク機器などが置かれた研究室"
      />

      <nav class="room-links" aria-label="サイトメニュー">
        {
          roomLinks.map((link) => (
            <a class={`room-link ${link.className}`} href={link.href}>
              <span class="hotspot" aria-hidden="true"></span>
              <span class="guide-card">
                <span class="guide-title">{link.title}</span>
                <span class="guide-description">{link.description}</span>
                <span class="guide-arrow" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </nav>
    </section>

    <nav class="mobile-menu" aria-label="サイトメニュー">
      {
        roomLinks.map((link) => (
          <a href={link.href}>
            <span>
              <strong>{link.title}</strong>
              <small>{link.description}</small>
            </span>
            <b aria-hidden="true">→</b>
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>

<style>
  .home-page {
    width: min(100% - 4rem, 1500px);
    margin: 0 auto;
    padding: 2.5rem 0 4rem;
  }

  .home-header { display: flex; align-items: center; justify-content: space-between; }
  .home-logo { color: #101728; font-family: var(--font-logo); font-size: clamp(2rem, 2.5vw, 3.2rem); font-weight: 400; letter-spacing: 0.01em; line-height: 1; }
  .room-menu {
    position: relative;
    width: 100%;
    max-width: 1500px;
    margin: clamp(0.25rem, 1vw, 1rem) auto 0;
    aspect-ratio: 16 / 9;
  }

  .room-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
  }

  .room-links { position: absolute; inset: 0; }

  .room-link {
    position: absolute;
    display: grid;
    place-items: center;
    outline: none;
  }

  .hotspot {
    position: relative;
    z-index: 2;
    width: clamp(0.55rem, 0.75vw, 0.72rem);
    aspect-ratio: 1;
    border: 2px solid #faf5f3;
    border-radius: 50%;
    background: #1e63c6;
    box-shadow: 0 0 0 0.2rem rgb(250 245 243 / 90%);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .guide-card {
    position: absolute;
    bottom: calc(50% + 0.95rem);
    left: 50%;
    z-index: 3;
    display: grid;
    gap: 0.35rem;
    min-width: clamp(10rem, 13vw, 13rem);
    padding: 1rem 1.15rem 1.25rem;
    border-radius: 0.7rem;
    background: rgb(255 254 253 / 97%);
    box-shadow: 0 0.5rem 1.25rem rgb(16 23 40 / 14%);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(0.4rem) scale(0.92);
    transform-origin: bottom center;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .guide-card::after {
    position: absolute;
    right: 1.15rem;
    bottom: 0.55rem;
    left: 1.15rem;
    height: 2px;
    background: #77a6ff;
    content: "";
  }

  .guide-title { color: #1e63c6; font-family: var(--font-handwriting); font-size: clamp(1.25rem, 1.8vw, 1.7rem); line-height: 1; }
  .guide-description { font-family: var(--font-japanese); font-size: clamp(0.68rem, 0.82vw, 0.82rem); font-weight: 700; white-space: nowrap; }
  .guide-arrow { position: absolute; right: 0.75rem; bottom: 0.8rem; z-index: 1; color: #1e63c6; font-family: var(--font-handwriting); font-size: 1.5rem; line-height: 1; }

  .room-link:hover .hotspot,
  .room-link:focus-visible .hotspot { transform: scale(1.18); box-shadow: 0 0 0 0.32rem rgb(30 99 198 / 18%); }
  .room-link:hover .guide-card,
  .room-link:focus-visible .guide-card { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }

  /* ホットスポットの配置：新しい room.png に合わせた値です。必要に応じて調整してください。 */
  .room-link--about { top: 31%; left: 7%; width: 16%; height: 36%; }
  .room-link--projects { top: 30%; left: 26%; width: 20%; height: 43%; }
  .room-link--research { top: 23%; left: 54%; width: 18%; height: 42%; }
  .room-link--notes { top: 73%; left: 40.5%; width: 20%; height: 22%; }
  .room-link--contact { top: 27%; left: 86%; width: 13%; height: 48%; }

  .mobile-menu { display: none; }

  @media (max-width: 700px) {
    .home-page { width: min(100% - 2rem, 1500px); padding-top: 1.5rem; }
    .room-menu { display: none; }
    .mobile-menu { display: grid; gap: 0.85rem; margin-top: 3rem; }
    .mobile-menu a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 5.8rem; padding: 1.1rem 1.25rem; border: 2px solid #b4b4b4; border-radius: 0.75rem; transition: border-color 180ms ease, transform 180ms ease; }
    .mobile-menu a:hover, .mobile-menu a:focus-visible { border-color: #1e63c6; outline: none; transform: translateY(-0.15rem); }
    .mobile-menu a span { display: grid; gap: 0.25rem; }
    .mobile-menu strong { color: #1e63c6; font-family: var(--font-handwriting); font-size: 1.8rem; font-weight: 400; }
    .mobile-menu small { font-size: 0.9rem; font-weight: 700; }
    .mobile-menu b { color: #1e63c6; font-family: var(--font-handwriting); font-size: 1.7rem; font-weight: 400; }
  }
</style>
