---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PreparingNote from "../components/PreparingNote.astro";
---

<BaseLayout title="Notes | Sae Yoshizaki" description="Sae Yoshizakiの技術ブログとメモ">
  <main class="preparing-page">
    <Header currentPath={Astro.url.pathname} />

    <section class="page-intro" aria-labelledby="notes-title">
      <h1 id="notes-title">Notes</h1>
    </section>

    <div class="preparing-note-wrap">
      <PreparingNote />
    </div>
  </main>
</BaseLayout>

<style>
  .preparing-page {
    width: min(100% - 2rem, 1500px);
    min-height: 100vh;
    margin: 0.75rem auto;
    padding: clamp(2rem, 4vw, 4rem) clamp(1.5rem, 4.5vw, 4.5rem) 6rem;
  }

  h1, p { margin: 0; }

  .page-intro {
    margin: clamp(2.25rem, 4vw, 3.5rem) 0 0 clamp(0.5rem, 4vw, 4.75rem);
  }

  h1 {
    display: inline-block;
    padding-bottom: 0.2rem;
    border-bottom: 3px solid #1e63c6;
    color: #1e63c6;
    font-family: var(--font-handwriting);
    font-size: clamp(2.4rem, 3.4vw, 3.3rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .page-intro p {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    color: #101728;
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    font-weight: 700;
    line-height: 1.9;
  }

  .preparing-note-wrap {
    display: grid;
    margin: clamp(2.5rem, 4vw, 3.75rem) auto 0;
    place-items: center;
  }

  .intro-line {
    display: block;
    width: clamp(7rem, 12vw, 11rem);
    height: 2px;
    margin-top: clamp(2rem, 3vw, 3rem);
    background: #101728;
  }

  @media (max-width: 640px) {
    .preparing-page { width: min(100% - 1rem, 1500px); padding-inline: 1rem; }
    .page-intro { margin-left: 0; }
    .page-intro p br { display: none; }
  }
</style>
